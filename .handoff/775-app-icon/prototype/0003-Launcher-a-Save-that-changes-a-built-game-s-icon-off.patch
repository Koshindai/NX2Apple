From 948eb281a169ace29c3e713057452eb5f5622f61 Mon Sep 17 00:00:00 2001
From: Koshindai <97556702+Koshindai@users.noreply.github.com>
Date: Tue, 3 Nov 2026 13:25:24 +0100
Subject: [PATCH] Launcher: a Save that changes a built game's icon offers to
 rebuild it

A notice at the bottom of the library says the new icon appears after a rebuild, with Later and Rebuild now. The note beside the status stays until the build.
---
 frontend-qt/nspb_qt/localization.py           |  3 +++
 .../Sources/NSPortBuilder/ArtworkEditor.swift | 15 ++++++++---
 .../Sources/NSPortBuilder/LauncherView.swift  | 26 +++++++++++++++++++
 .../Sources/NSPortBuilder/Localization.swift  |  9 +++++++
 .../ArtworkEditorTests.swift                  |  7 ++++-
 5 files changed, 55 insertions(+), 5 deletions(-)

diff --git a/frontend-qt/nspb_qt/localization.py b/frontend-qt/nspb_qt/localization.py
index 0105e029..51fe5176 100644
--- a/frontend-qt/nspb_qt/localization.py
+++ b/frontend-qt/nspb_qt/localization.py
@@ -459,6 +459,9 @@ TABLE: dict[str, tuple[str, str, str, str]] = {
     'artwork.preview.dock': ('程序坞', 'Dock', 'Dock', 'Dock'),
     'artwork.preview.iphone': ('iPhone', 'iPhone', 'iPhone', 'iPhone'),
     'artwork.reset.icon': ('重置图标', 'Reset icon', 'Återställ ikon', 'Symbol zurücksetzen'),
+    'artwork.saved': ('图片已保存', 'Artwork saved', 'Omslagsbilden har sparats', 'Titelbild gespeichert'),
+    'artwork.iconAfterRebuild': ('新的应用图标会在重新构建后出现。', 'The new app icon appears after a rebuild.', 'Den nya appikonen visas efter att appen byggts om.', 'Das neue App-Symbol erscheint nach einem neuen Build.'),
+    'artwork.rebuildNow': ('立即重新构建', 'Rebuild now', 'Bygg om nu', 'Jetzt neu bauen'),
     'artwork.grid.icon': ('应用图标选项', 'App icon choices', 'Val av appikon', 'Auswahl des App-Symbols'),
     'artwork.dropHint.icon': ('松开以用作应用图标', 'Drop to use as the app icon', 'Släpp för att använda som appikon', 'Zum Verwenden als App-Symbol ablegen'),
     'library.viewBuild': ('查看构建', 'View build', 'Visa bygge', 'Build ansehen'),
diff --git a/frontend/Sources/NSPortBuilder/ArtworkEditor.swift b/frontend/Sources/NSPortBuilder/ArtworkEditor.swift
index e5eab85e..ade36db0 100644
--- a/frontend/Sources/NSPortBuilder/ArtworkEditor.swift
+++ b/frontend/Sources/NSPortBuilder/ArtworkEditor.swift
@@ -464,18 +464,25 @@ struct ArtworkEditorEnvironment {
 }
 
 /// The hero's note "New app icon at the next build": the game it is for. It is set by a Save that changed the icon of a game that is
-/// built, and goes when that game is built again or another game is selected.
+/// built, and goes when that game is built again or another game is selected. The same Save offers a rebuild at the bottom of the
+/// library, until Later, Rebuild now or the note goes.
 struct IconNote: Equatable {
     private(set) var game: UUID?
+    private(set) var offered = false
 
     /// `iconChanged` is the editor's `savedIconChange`.
     mutating func saved(iconChanged: Bool, game built: LibraryGame) {
-        if iconChanged && built.hasBuild { game = built.id }
+        if iconChanged && built.hasBuild { game = built.id; offered = true }
     }
 
-    mutating func selected(_ id: UUID?) { if id != game { game = nil } }
+    mutating func selected(_ id: UUID?) { if id != game { game = nil; offered = false } }
 
-    mutating func rebuilt(_ id: UUID) { if game == id { game = nil } }
+    mutating func rebuilt(_ id: UUID) { if game == id { game = nil; offered = false } }
+
+    /// Later or Rebuild now: the offer goes, the note stays until the build.
+    mutating func answered() { offered = false }
 
     func shows(for id: UUID) -> Bool { game == id }
+
+    func offers(for id: UUID) -> Bool { offered && game == id }
 }
diff --git a/frontend/Sources/NSPortBuilder/LauncherView.swift b/frontend/Sources/NSPortBuilder/LauncherView.swift
index 6e51875c..65e9714d 100644
--- a/frontend/Sources/NSPortBuilder/LauncherView.swift
+++ b/frontend/Sources/NSPortBuilder/LauncherView.swift
@@ -149,6 +149,7 @@ struct ContentView: View {
                     // The activity bar stays under the library, so the panel runs to the window's bottom edge with its buttons
                     VStack(spacing: 0) {
                         libraryPage
+                            .overlay(alignment: .bottom) { rebuildOffer }
                             .allowsHitTesting(artworkEditor == nil)   // the library stays visible as the live preview, and takes no click or Return
                             .transaction { if reduceMotion { $0.animation = nil } }   // under Reduce Motion the panel fades in, nothing moves
                         activityBar
@@ -558,6 +559,31 @@ struct ContentView: View {
         .frame(width: width, height: height).clipped()
     }
 
+    /// After a Save that changed a built game's icon: the new icon is in the app only after a build, so one is offered here.
+    @ViewBuilder private var rebuildOffer: some View {
+        if artworkEditor == nil, let game = library.selected, iconNote.offers(for: game.id), !(m.running && activeBuildID == game.id) {
+            HStack(spacing: 16) {
+                VStack(alignment: .leading, spacing: 2) {
+                    Text(m.t("artwork.saved")).font(.manrope(14, .semibold))
+                    Text(m.t("artwork.iconAfterRebuild")).font(.manrope(12)).foregroundStyle(.secondary)
+                }
+                Button(m.t("update.later")) { iconNote.answered() }
+                    .buttonStyle(LauncherSecondaryButtonStyle())
+                    .padTarget("offer.later", scope: "main", radius: 9) { iconNote.answered() }
+                Button(m.t("artwork.rebuildNow")) { iconNote.answered(); configureBuild(game) }
+                    .buttonStyle(LauncherPrimaryButtonStyle()).disabled(m.running || game.inputs["base", default: []].isEmpty)
+                    .padTarget("offer.rebuild", scope: "main", radius: 9) { if !m.running { iconNote.answered(); configureBuild(game) } }
+            }
+            .padding(.leading, 18).padding(.trailing, 14).padding(.vertical, 12)
+            .background(LauncherPalette.surface, in: RoundedRectangle(cornerRadius: 14, style: .continuous))
+            .overlay(RoundedRectangle(cornerRadius: 14, style: .continuous).strokeBorder(.white.opacity(0.10)))
+            .shadow(color: .black.opacity(0.55), radius: 15, y: 10)
+            .accessibilityElement(children: .contain)
+            .padding(.bottom, 24)
+            .transition(.move(edge: .bottom).combined(with: .opacity))
+        }
+    }
+
     private func collection(width: CGFloat) -> some View {
         let cardWidth = min(300, max(190, (width - 124) / 5))
         let step = cardWidth + 14
