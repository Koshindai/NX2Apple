From c6297fd75ec7ff1c1feb33af10e2aded89f94f92 Mon Sep 17 00:00:00 2001
From: Koshindai <97556702+Koshindai@users.noreply.github.com>
Date: Tue, 3 Nov 2026 09:44:49 +0100
Subject: [PATCH] Launcher: the icon previews show the Dock's running dot and
 the Home Screen's name

---
 .../Sources/NSPortBuilder/ArtworkPanel.swift    | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/frontend/Sources/NSPortBuilder/ArtworkPanel.swift b/frontend/Sources/NSPortBuilder/ArtworkPanel.swift
index a9e2eb8c..47802d86 100644
--- a/frontend/Sources/NSPortBuilder/ArtworkPanel.swift
+++ b/frontend/Sources/NSPortBuilder/ArtworkPanel.swift
@@ -172,21 +172,23 @@ struct ArtworkPanel: View {
 
     // MARK: The icon's previews
 
-    /// The chosen icon as the Mac's Dock and the iPhone's Home Screen draw it, each on a dim wallpaper-ish tile.
+    /// The chosen icon as the Mac's Dock (with the dot of a running app) and the iPhone's Home Screen (with the game's name)
+    /// draw it, each on a dim wallpaper-ish tile.
     private var iconPreviews: some View {
         HStack(alignment: .top, spacing: 12) {
-            iconPreview(title: t("artwork.preview.dock"), side: 64, radius: 64 * 0.225, style: .circular,
+            iconPreview(title: t("artwork.preview.dock"), side: 64, radius: 64 * 0.225, style: .circular, named: false,
                         wallpaper: [Color(red: 0.23, green: 0.23, blue: 0.25), Color(red: 0.12, green: 0.12, blue: 0.14)])
-            iconPreview(title: t("artwork.preview.iphone"), side: 60, radius: 60 * 0.2237, style: .continuous,
+            iconPreview(title: t("artwork.preview.iphone"), side: 60, radius: 60 * 0.2237, style: .continuous, named: true,
                         wallpaper: [Color(red: 0.14, green: 0.20, blue: 0.29), Color(red: 0.23, green: 0.14, blue: 0.25)])
         }
         .accessibilityElement(children: .contain)
     }
 
-    private func iconPreview(title: String, side: CGFloat, radius: CGFloat, style: RoundedCornerStyle, wallpaper: [Color]) -> some View {
+    private func iconPreview(title: String, side: CGFloat, radius: CGFloat, style: RoundedCornerStyle, named: Bool, wallpaper: [Color]) -> some View {
         VStack(spacing: 8) {
             ZStack {
                 RoundedRectangle(cornerRadius: 14, style: .continuous).fill(LinearGradient(colors: wallpaper, startPoint: .top, endPoint: .bottom))
+                VStack(spacing: named ? 4 : 5) {
                 Group {
                     if let file = editor.selectedFile, let image = ArtworkImages.shared.image(at: file, maxPixel: 256) {
                         Image(nsImage: image).resizable().scaledToFill()
@@ -196,6 +198,13 @@ struct ArtworkPanel: View {
                 }
                 .frame(width: side, height: side)
                 .clipShape(RoundedRectangle(cornerRadius: radius, style: style))
+                if named {
+                    Text(editor.gameName).font(.system(size: 11, weight: .medium)).foregroundStyle(.white)
+                        .lineLimit(1).truncationMode(.tail).frame(maxWidth: side + 24)
+                } else {
+                    Circle().fill(Color.white.opacity(0.8)).frame(width: 4, height: 4)
+                }
+                }
             }
             .frame(height: 96)
             Text(title).font(.manrope(12)).foregroundStyle(.secondary)
-- 
