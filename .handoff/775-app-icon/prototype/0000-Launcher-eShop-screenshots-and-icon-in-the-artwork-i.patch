@@ -666,14 +666,15 @@ final class GameLibrary: ObservableObject {
         return urls
     }
 
-    /// The file a choice shows, if it has one. Screenshots and the eShop icon have none until they are downloaded.
+    /// The file a choice shows, if it has one. Screenshots and the eShop icon have none until they are downloaded (ArtworkStore.candidate).
     private static func file(for choice: ArtworkChoice?, of game: LibraryGame, banners: URL) -> URL? {
         let url: URL?
         switch choice?.source {
         case .banner: url = ArtworkStore.cachedBanner(game.titleID, in: banners)
         case .imported(let name) where name == URL(fileURLWithPath: name).lastPathComponent && name != "..":   // a name in the game's folder, never a path
             url = ArtworkStore.customDirectory(for: game.id, in: banners).appendingPathComponent(name)
-        case .screenshot, .eshopIcon, .gameIcon, .imported, nil: url = nil
+        case .screenshot?, .eshopIcon?: url = choice.flatMap { ArtworkStore.cachedCandidate($0.source, titleID: game.titleID, in: banners) }
+        case .gameIcon, .imported, nil: url = nil
         }
         return url.flatMap { FileManager.default.fileExists(atPath: $0.path) ? $0 : nil }
     }
diff --git a/frontend/Tests/NSPortBuilderTests/ArtworkStoreMediaTests.swift b/frontend/Tests/NSPortBuilderTests/ArtworkStoreMediaTests.swift
